<IfModule mod_rewrite.c>
    # Https Forced
    RewriteEngine On
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
    
    # Fix double public paths
    RewriteCond %{REQUEST_URI} ^/(app/public/public|public/public)/(.*)$
    RewriteRule ^ /public/%2 [L,R=301]
    
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(assets/images/|images/)(.*)$ /public/assets/images/$2 [L,R=301]
    
    # Block direct /app/ access
    RewriteRule ^app/ - [F]

    RewriteCond %{REQUEST_METHOD} OPTIONS
    RewriteRule ^ - [R=204,L]

</IfModule>
    # CORs Policy
    Header set Access-Control-Allow-Origin "https://shielded-garden-06013-bc1acbc5ebcd.herokuapp.com"
    Header set Access-Control-Allow-Methods "GET, POST, OPTIONS"
    Header set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With, X-CSRF-Token"
    Header set Access-Control-Allow-Credentials "true"
    Header set Access-Control-Max-Age "3600"
    SetEnvIf Origin "^(https://shielded-garden-06013-bc1acbc5ebcd\.herokuapp\.com)$" CORS_ALLOW_ORIGIN=$1
    Header set Access-Control-Allow-Origin "%{CORS_ALLOW_ORIGIN}e" env=CORS_ALLOW_ORIGIN
    Header set Access-Control-Allow-Credentials "true" env=CORS_ALLOW_ORIGIN

    # Security Headers 
    Header always set X-Frame-Options "DENY"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header edit Set-Cookie ^(.*)$ "$1; SameSite=Lax"
    Header always set Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'nonce-{random}' https://static.tradingview.com https://*.tradingview.com https://*.ampproject.org https://*.paypal.com https://platform.twitter.com https://platform.x.com https://songbird.cardinalcommerce.com https://checkout.razorpay.com https://*.checkout.com; style-src 'self' 'nonce-{random}' https://fonts.googleapis.com https://ka-f.fontawesome.com; img-src 'self' data: https://*.tradingview.com https://thumbs.dreamstime.com https://s3.tradingview.com; font-src 'self' https://fonts.gstatic.com https://ka-f.fontawesome.com; connect-src 'self' https://*.tradingview.com https://shielded-garden-06013-bc1acbc5ebcd.herokuapp.com; frame-src 'self' https://*.tradingview.com; frame-ancestors 'none'; form-action 'self'; base-uri 'self'; object-src 'none'; report-uri https://shielded-garden-06013-bc1acbc5ebcd.herokuapp.com/csp-report-endpoint"
    

    # Cache control 
    <FilesMatch "\.(php)$">
        Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
        Header set Expires "Sat, 1 Jan 2000 00:00:00 GMT"
    </FilesMatch>

   