# Disable directory listing and MultiViews
Options -Indexes -MultiViews

# Allow cross-origin requests (for CDN/embeds)
<IfModule mod_headers.c>
    Header set Access-Control-Allow-Origin "*"
</IfModule>

# Image file handling (combined single section)
<FilesMatch "\.(jpg|jpeg|png|gif|webp|svg)$">
    # Allow public access
    Require all granted
    
    # Cache for 1 month (30 days)
    Header set Cache-Control "max-age=2592000, public, immutable"
    
    # Security headers
    Header set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    
    # Remove ETags to prevent inconsistent caching
    Header unset ETag
    FileETag None
</FilesMatch>

# Prevent execution of scripts in upload directories
<FilesMatch "\.(php|cgi|pl|sh|exe)$">
    Require all denied
</FilesMatch>

# Force proper MIME types
<IfModule mod_mime.c>
    AddType image/webp .webp
    AddType image/svg+xml .svg
</IfModule>

# URL rewriting - Front Controller pattern
<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Redirect to HTTPS first
    RewriteCond %{HTTPS} off
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
    
    # Handle front controller
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>

# Security enhancements
<IfModule mod_headers.c>
    # Prevent content type sniffing
    Header always set X-Content-Type-Options "nosniff"
    
    # Enable XSS protection
    Header always set X-XSS-Protection "1; mode=block"
    
    # Prevent MIME type confusion
    Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data:;"
</IfModule>