<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Redirect /public/images/ to /assets/images/
    RewriteRule ^public/images/(.*)$ /assets/images/$1 [L,R=301]
    
    # Front controller
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php [L]
</IfModule>

# Image handling - critical fixes
<FilesMatch "\.(jpg|jpeg|png|gif|webp)$">
    # Fix typo in 'Require' and set proper permissions
    Require all granted
    Allow from all
    
    # Cache settings
    Header set Cache-Control "public, max-age=604800, immutable"
    ErrorDocument 404 /assets/images/default.jpg
    
    # Security headers
    Header set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    
    # Force correct MIME types
    ForceType image/jpeg
    ForceType image/png
    ForceType image/gif
    ForceType image/webp
</FilesMatch>

# Front controller pattern
<IfModule mod_rewrite.c>
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>

# Security enhancements (simplified)
<IfModule mod_headers.c>
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data: https:"
    Header set Content-Security-Policy "style-src 'self' 'unsafe-inline';"
    Header unset ETag
    FileETag None
</IfModule>

# Disable directory browsing
Options -Indexes -MultiViews