<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Remove /app/ from any URLs
    RewriteCond %{REQUEST_URI} ^/app/(.*)
    RewriteRule ^(.*)$ /%1 [L,R=301]
    
    RewriteRule ^assets/(.*)$ public/assets/$1 [L,R=301]

    <FilesMatch "\.(jpg|jpeg|png|gif|webp)$">
        # Force correct Content-Type
        Header set Content-Type "image/jpeg" env=!REDIRECT_content-type
        Header set Content-Type "image/png" env=!REDIRECT_content-type
        Header set Content-Type "image/gif" env=!REDIRECT_content-type
        Header set Content-Type "image/webp" env=!REDIRECT_content-type
    </FilesMatch>
</IfModule>
