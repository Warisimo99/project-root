<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Redirect /assets/ to /public/assets/
    RewriteRule ^assets/(.*)$ public/assets/$1 [L,R=301]
    
    # Ensure images are served with correct MIME type
    <FilesMatch "\.(jpg|jpeg|png|gif|webp)$">
        Header set Content-Type "image/%{MATCH_EXT}e"
        Require all granted
    </FilesMatch>
</IfModule>
