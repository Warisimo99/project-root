<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Fix double public paths
    RewriteCond %{REQUEST_URI} ^/(app/public/public|public/public)/(.*)$
    RewriteRule ^ /public/%2 [L,R=301]
    
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(assets/images/|images/)(.*)$ /public/assets/images/$2 [L,R=301]
    
    # Block direct /app/ access
    RewriteRule ^app/ - [F]

    RewriteCond %{REQUEST_METHOD} OPTIONS
    RewriteRule ^ - [R=204,L]

</IfModule>

    Header set Access-Control-Allow-Origin "https://shielded-garden-06013-bc1acbc5ebcd.herokuapp.com"
    Header set Access-Control-Allow-Methods "GET, POST, OPTIONS"
    Header set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With, X-CSRF-Token"
    Header set Access-Control-Allow-Credentials "true"
    Header set Access-Control-Max-Age "3600"

    # Security Headers 
    Header always set X-Frame-Options "DENY"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Cache control - Expanded version
    <FilesMatch "\.(php|html|htm|json)$">
        Header set Cache-Control "no-store, no-cache, must-revalidate, private"
        Header set Pragma "no-cache"
        Header set Expires "Wed, 11 Jan 1984 05:00:00 GMT"
    </FilesMatch>

    # Session protection
    php_flag session.cookie_httponly on
    php_flag session.cookie_secure on
    php_flag session.use_strict_mode on